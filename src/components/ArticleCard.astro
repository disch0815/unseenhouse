---
import type { CollectionEntry } from 'astro:content';
import { LOCALES, type Lang } from '../i18n';

interface Props {
  artikel: CollectionEntry<'artikel'>;
  lang?: Lang;
}

const { artikel, lang = 'de' } = Astro.props;
const slug = artikel.id.split('/')[1];
const base = LOCALES[lang].artikelBase;
---

<article class="card">
  <h3><a href={`${base}/${slug}`}>{artikel.data.title}</a></h3>
  <p>{artikel.data.description}</p>
</article>

<style>
  h3 {
    margin: 0 0 8px;
    line-height: 1.35;
  }

  h3 a {
    text-decoration: none;
    color: var(--text);
  }

  h3 a:hover {
    color: var(--accent);
  }

  p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
  }
</style>
